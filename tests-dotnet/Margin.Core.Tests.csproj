<!--
  Runs the Margin.Core tests outside Unity (CI / no editor):
    dotnet test tests-dotnet
  Compiles the same sources Unity uses; Unity ignores this folder (it is outside Assets/).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../Assets/Tests/EditMode/**/*.cs" />
    <None Include="../Assets/Resources/Data/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Data" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
